<Project>

  <!--
    Centralized build settings. Values defined here apply to every project in
    the solution; individual .csproj files only override when they need to
    diverge. Keeps the "best-practice baseline" in one place.
  -->

  <PropertyGroup>
    <TargetFramework>net10.0</TargetFramework>
    <LangVersion>latest</LangVersion>
    <Nullable>enable</Nullable>
    <ImplicitUsings>enable</ImplicitUsings>
  </PropertyGroup>

  <PropertyGroup>
    <TreatWarningsAsErrors>true</TreatWarningsAsErrors>
    <EnforceCodeStyleInBuild>true</EnforceCodeStyleInBuild>
    <AnalysisLevel>latest</AnalysisLevel>
    <AnalysisMode>All</AnalysisMode>
  </PropertyGroup>

  <!--
    Documentation generation is enabled per-project (library only, not tests)
    once the public surface stabilizes. Until then it is off to avoid noisy
    CS1591 errors during the API refactor.
  -->

</Project>
