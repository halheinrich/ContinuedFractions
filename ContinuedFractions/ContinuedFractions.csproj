<Project Sdk="Microsoft.NET.Sdk">

  <PropertyGroup>
    <RootNamespace>HalHeinrich.Numerics.ContinuedFractions</RootNamespace>
  </PropertyGroup>

  <!--
    BigRational by ProjectReference, per the umbrella's ruling on intra-umbrella
    edges. The path escapes this repository: it resolves only when this checkout
    sits beside a BigRationalLibrary checkout, as it does inside the umbrella.
    See README.md - Building.
  -->
  <ItemGroup>
    <ProjectReference Include="..\..\BigRationalLibrary\BigRationalLibrary\BigRationalLibrary.csproj" />
  </ItemGroup>

  <!--
    Assembly name, not namespace: the test project is still assembled as
    ContinuedFractions.Tests, and the namespace rooting did not rename it.
  -->
  <ItemGroup>
    <InternalsVisibleTo Include="ContinuedFractions.Tests" />
  </ItemGroup>

</Project>
