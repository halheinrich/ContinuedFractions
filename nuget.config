<?xml version="1.0" encoding="utf-8"?>
<configuration>

  <!--
    Package sources for this solution. <clear /> drops any inherited sources
    from machine-level NuGet.Config so the build is reproducible from this
    file alone.
  -->
  <packageSources>
    <clear />
    <add key="nuget.org" value="https://api.nuget.org/v3/index.json" protocolVersion="3" />
    <add key="github" value="https://nuget.pkg.github.com/halheinrich/index.json" />
  </packageSources>

  <!--
    GitHub Packages credentials are read from the GITHUB_PACKAGES_PAT
    environment variable so no token is committed. The variable must be
    set in the User environment (or equivalent) before restore.
  -->
  <packageSourceCredentials>
    <github>
      <add key="Username" value="halheinrich" />
      <add key="ClearTextPassword" value="%GITHUB_PACKAGES_PAT%" />
    </github>
  </packageSourceCredentials>

  <!--
    Source mapping pins every package to a specific feed. HalHeinrich.*
    packages must come from the github feed; everything else from nuget.org.
    Prevents a typosquat / dependency-confusion attack where a malicious
    actor publishes "HalHeinrich.X" to nuget.org.
  -->
  <packageSourceMapping>
    <packageSource key="github">
      <package pattern="HalHeinrich.*" />
    </packageSource>
    <packageSource key="nuget.org">
      <package pattern="*" />
    </packageSource>
  </packageSourceMapping>

</configuration>
