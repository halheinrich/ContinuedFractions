<Project Sdk="Microsoft.NET.Sdk">

  <PropertyGroup>
    <RootNamespace>HalHeinrich.Numerics.ContinuedFractions.Tests</RootNamespace>
    <IsPackable>false</IsPackable>

    <!--
      GenerateDocumentationFile is inherited as true from Directory.Build.props.
      It is IDE0005's documented prerequisite (roslyn#41640), so opting out here
      made the rule structurally unable to fire in this project - the hole
      halheinrich/Math#43 found. An unused using rots identically in a test, so
      the prerequisite is met and the undocumented-member warning the generated
      file provokes is suppressed instead. Test methods are named, not
      documented; CS1591 is the only part of doc generation this project wants
      no part of.
    -->
    <NoWarn>$(NoWarn);CS1591</NoWarn>
  </PropertyGroup>

  <ItemGroup>
    <PackageReference Include="coverlet.collector" Version="6.0.4" />
    <PackageReference Include="Microsoft.NET.Test.Sdk" Version="17.14.1" />
    <PackageReference Include="xunit" Version="2.9.3" />
    <PackageReference Include="xunit.runner.visualstudio" Version="3.1.4" />
  </ItemGroup>

  <ItemGroup>
    <Using Include="Xunit" />
  </ItemGroup>

  <ItemGroup>
    <ProjectReference Include="..\ContinuedFractions\ContinuedFractions.csproj" />
  </ItemGroup>

</Project>
